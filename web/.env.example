# =============================================================================
# Pengaturan SIGAP JUMBARA (salin menjadi web\.env lalu isi).
#   copy .env.example .env
# File .env berisi rahasia: JANGAN di-commit, JANGAN dikirim lewat chat/WA.
# Baris yang diawali # adalah komentar.
# =============================================================================

# --- Dasar Django --------------------------------------------------------------
# False di server produksi. True hanya di laptop pengembangan.
DJANGO_DEBUG=False
# Kunci rahasia acak (minimal 50 karakter). Buat dengan:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=ganti-dengan-kunci-acak-panjang
# Nama domain yang boleh dipakai, pisahkan dengan koma. Contoh:
#   DJANGO_ALLOWED_HOSTS=sigapjumbara.id,www.sigapjumbara.id,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Alamat lengkap dengan https, pisahkan dengan koma (wajib agar form bisa dikirim lewat HTTPS).
#   CSRF_TRUSTED_ORIGINS=https://sigapjumbara.id
CSRF_TRUSTED_ORIGINS=
# Alamat utama web (dipakai untuk QR link form dan teks). Tanpa garis miring di akhir.
SIGAP_URL=http://localhost:8000

# --- HTTPS ---------------------------------------------------------------------
# True jika web diakses lewat HTTPS (Cloudflare Tunnel atau win-acme). Membuat cookie "secure".
SIGAP_HTTPS=True
# Biarkan False jika memakai Cloudflare Tunnel (Cloudflare yang mengalihkan ke https).
SECURE_SSL_REDIRECT=False
# Isi 31536000 hanya setelah HTTPS stabil di domain final. 0 = mati.
SECURE_HSTS_SECONDS=0

# --- Database MariaDB (10.5 atau lebih baru) ------------------------------------
DB_NAME=sigap_jumbara
DB_USER=sigap
DB_PASSWORD=
DB_HOST=127.0.0.1
# 3306 jika MariaDB baru menggantikan MySQL XAMPP; 3307 jika dipasang berdampingan.
DB_PORT=3306
# Database khusus tes otomatis (pytest). Jangan sama dengan DB_NAME.
DB_TEST_NAME=sigap_jumbara_test

# --- Kunci data pribadi (NIK) ---------------------------------------------------
# NIK disimpan terenkripsi. Kunci di bawah WAJIB dicadangkan di tempat aman (misalnya
# flashdisk + pengelola kata sandi). Jika hilang, NIK di database tidak bisa dibaca lagi.
# Buat kunci enkripsi:
#   .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Untuk mengganti kunci: taruh kunci baru di depan, kunci lama di belakang, pisah koma.
SIGAP_KUNCI_NIK=
# Kunci HMAC untuk cek NIK dobel (acak, jangan pernah diganti setelah ada data):
#   .venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
SIGAP_KUNCI_HASH_NIK=

# --- Folder (pakai path lengkap Windows) ----------------------------------------
# Foto dan file privat. HARUS di luar folder static dan di luar htdocs Apache.
SIGAP_FOLDER_PRIVAT=C:\sigap-jumbara\web\privat
# Cadangan database + foto. Sebaiknya di disk lain, misalnya D:\cadangan-sigap
SIGAP_FOLDER_CADANGAN=D:\cadangan-sigap
SIGAP_CADANGAN_SIMPAN_HARI=14
# Program mysqldump/mariadb-dump dari MariaDB yang dipakai (versi sama dengan server).
SIGAP_MYSQLDUMP_PATH=C:\Program Files\MariaDB 10.11\bin\mariadb-dump.exe
# Folder log aplikasi.
SIGAP_FOLDER_LOG=C:\sigap-jumbara\web\logs

# --- Kata sandi awal tiga akun (dipakai sekali oleh sigap_seed) ------------------
# Minimal 10 karakter. Jika kosong, sigap_seed membuat sandi acak dan menampilkannya sekali.
# Setelah login pertama, segera ganti dari menu Akun.
SIGAP_SANDI_AWAL_SUPERADMIN=
SIGAP_SANDI_AWAL_PANITIA=
SIGAP_SANDI_AWAL_JURI=

# --- Waitress -------------------------------------------------------------------
WAITRESS_THREADS=48
WAITRESS_PORT=8000
